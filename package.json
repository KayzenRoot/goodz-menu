{
  "name": "goodz-menu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "security:braces-disposition": "node scripts/verify-eslint-braces-not-affected.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-local-e2e.mjs",
    "test:supabase:authz": "node tests/supabase/tenant-authorization.integration.mjs",
    "test:supabase:catalog": "node tests/supabase/catalog-data-api.integration.mjs",
    "test:supabase:settings": "node tests/supabase/settings-data-api.integration.mjs",
    "test:supabase:orders": "node tests/supabase/orders-data-api.integration.mjs",
    "test:supabase:delivery": "node tests/supabase/delivery-data-api.integration.mjs",
    "test:supabase:storefront": "node tests/supabase/storefront-data-api.integration.mjs",
    "test:supabase:privacy": "node tests/supabase/privacy-data-api.integration.mjs",
    "verify:prod-readiness": "node scripts/verify-production-readiness.mjs",
    "verify:backup-drill": "node scripts/verify-backup-restore-drill.mjs",
    "supabase:init": "supabase init",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test:db": "supabase test db --local",
    "supabase:types": "node scripts/generate-supabase-types.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "1.49.0",
    "motion": "13.5.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "postcss": "8.5.28",
    "supabase": "2.119.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  }
