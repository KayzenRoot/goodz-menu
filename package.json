{
  "name": "goodz-menu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docker:up": "node scripts/compose-local.mjs up",
    "docker:down": "node scripts/compose-local.mjs down",
    "docker:ps": "node scripts/compose-local.mjs ps",
    "docker:logs": "node scripts/compose-local.mjs logs",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:reset": "node scripts/supabase-local.mjs reset",
    "security:deps": "pnpm audit --audit-level high",
    "security:secrets": "node scripts/check-runtime-secrets.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "postcss": "8.5.31",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
